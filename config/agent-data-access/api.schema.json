{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "FlowSQL controlled data access tools",
  "description": "POST /data-access/call accepts {name,arguments}; GET /data-access/tools returns these MCP tool contracts. All routes require a deployment-issued audience-bound bearer token. Unknown properties and arbitrary SQL/paths/credentials are rejected.",
  "tools": [
    {
      "name": "list_sources",
      "description": "发现当前主体获准的真实来源、结构状态和可用能力；不加载数据或消费流。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "sources",
              "has_more",
              "total_sources",
              "offset"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source_ref",
                    "kind",
                    "provider",
                    "name",
                    "locator",
                    "description",
                    "capabilities"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "object",
                      "required": [
                        "source_id",
                        "source_revision"
                      ],
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_revision": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "kind": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "locator": {
                      "type": "object"
                    },
                    "description": {
                      "type": "object"
                    },
                    "capabilities": {
                      "type": "object"
                    }
                  }
                }
              },
              "has_more": {
                "type": "boolean"
              },
              "total_sources": {
                "type": "integer",
                "minimum": 0
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "describe_source",
      "description": "描述已发现来源的真实结构与语义依据；来源身份和修订须匹配。",
      "inputSchema": {
        "type": "object",
        "required": [
          "source_ref"
        ],
        "properties": {
          "source_ref": {
            "type": "object",
            "required": [
              "source_id",
              "source_revision"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "source_ref",
              "kind",
              "provider",
              "name",
              "locator",
              "description",
              "capabilities"
            ],
            "properties": {
              "source_ref": {
                "type": "object",
                "required": [
                  "source_id",
                  "source_revision"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "kind": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "locator": {
                "type": "object"
              },
              "description": {
                "type": "object"
              },
              "capabilities": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "query",
      "description": "提交结构化单来源有界查询。workflow 支持 filter、raw/aggregate/histogram view、sort；字段由 describe_source 提供。DataFrame 必须显式 capture_snapshot=true。",
      "inputSchema": {
        "type": "object",
        "required": [
          "request_id",
          "source_ref",
          "workflow"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_ref": {
            "type": "object",
            "required": [
              "source_id",
              "source_revision"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_revision": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "workflow": {
            "type": "array",
            "maxItems": 31,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "filter"
                      ]
                    },
                    "filters": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "$ref": "#/definitions/filter"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "filters"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "view"
                      ]
                    },
                    "query": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "enum": [
                                  "raw"
                                ]
                              },
                              "fields": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 256,
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                }
                              }
                            },
                            "required": [
                              "op",
                              "fields"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "enum": [
                                  "aggregate"
                                ]
                              },
                              "groupBy": {
                                "type": "array",
                                "maxItems": 256,
                                "items": {
                                  "oneOf": [
                                    {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 256
                                    },
                                    {
                                      "type": "object",
                                      "properties": {
                                        "field": {
                                          "type": "string",
                                          "minLength": 1,
                                          "maxLength": 256
                                        },
                                        "unit": {
                                          "enum": [
                                            "day",
                                            "month"
                                          ]
                                        },
                                        "asFieldKey": {
                                          "type": "string",
                                          "minLength": 1,
                                          "maxLength": 256
                                        }
                                      },
                                      "required": [
                                        "field",
                                        "unit",
                                        "asFieldKey"
                                      ],
                                      "additionalProperties": false
                                    }
                                  ]
                                }
                              },
                              "measures": {
                                "type": "array",
                                "maxItems": 256,
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "field": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 256
                                    },
                                    "agg": {
                                      "enum": [
                                        "count",
                                        "sum",
                                        "mean",
                                        "min",
                                        "max",
                                        "distinctCount"
                                      ]
                                    },
                                    "asFieldKey": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 256
                                    }
                                  },
                                  "required": [
                                    "field",
                                    "agg",
                                    "asFieldKey"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "op",
                              "groupBy",
                              "measures"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "enum": [
                                  "histogram"
                                ]
                              },
                              "field": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "bins": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                              }
                            },
                            "required": [
                              "op",
                              "field",
                              "bins"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "query"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "sort"
                      ]
                    },
                    "by": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "sort": {
                      "enum": [
                        "ascending",
                        "descending"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "by",
                    "sort"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "capture_snapshot": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 67108864
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        },
        "additionalProperties": false,
        "definitions": {
          "filter": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "fid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "rule": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "comparison",
                          "range",
                          "one of",
                          "not in",
                          "is null",
                          "is not null"
                        ]
                      },
                      "op": {
                        "enum": [
                          "eq",
                          "ne",
                          "lt",
                          "lte",
                          "gt",
                          "gte"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": [
                              "null",
                              "boolean",
                              "integer",
                              "number",
                              "string"
                            ]
                          },
                          {
                            "type": "array",
                            "maxItems": 1024,
                            "items": {
                              "type": [
                                "null",
                                "boolean",
                                "integer",
                                "number",
                                "string"
                              ]
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "fid",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "enum": [
                      "and",
                      "or"
                    ]
                  },
                  "filters": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "$ref": "#/definitions/filter"
                    }
                  }
                },
                "required": [
                  "op",
                  "filters"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "operation_id",
              "request_id",
              "arguments_sha256",
              "kind",
              "status"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "arguments_sha256": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "query",
                  "analysis"
                ]
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "cancelling",
                  "completed",
                  "failed",
                  "cancelled",
                  "interrupted",
                  "reconcile_required"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_operation",
      "description": "按稳定身份或原请求身份核对实际执行状态；重启后中断不会冒充成功。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "operation_id",
              "request_id",
              "arguments_sha256",
              "kind",
              "status"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "arguments_sha256": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "query",
                  "analysis"
                ]
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "cancelling",
                  "completed",
                  "failed",
                  "cancelled",
                  "interrupted",
                  "reconcile_required"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cancel_operation",
      "description": "请求取消，终态以执行端核对为准。",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "operation_id",
              "request_id",
              "arguments_sha256",
              "kind",
              "status"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "arguments_sha256": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "query",
                  "analysis"
                ]
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "cancelling",
                  "completed",
                  "failed",
                  "cancelled",
                  "interrupted",
                  "reconcile_required"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_result",
      "description": "分页读取同一不可变结果和执行依据。大整数/Decimal/二进制有无损类型标签。",
      "inputSchema": {
        "type": "object",
        "required": [
          "result_ref"
        ],
        "properties": {
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "lease_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "fields",
              "rows",
              "basis",
              "result_ref",
              "content_sha256",
              "schema_sha256",
              "offset",
              "total_rows",
              "row_json",
              "integrity_header",
              "has_more"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "field_id",
                    "native_type",
                    "nullable"
                  ]
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "value"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "int64",
                              "float64",
                              "decimal",
                              "string",
                              "binary_hex"
                            ]
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "basis": {
                "type": "object"
              },
              "result_ref": {
                "type": "string"
              },
              "content_sha256": {
                "type": "string"
              },
              "schema_sha256": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "total_rows": {
                "type": "integer",
                "minimum": 0
              },
              "row_json": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "integrity_header": {
                "type": "string"
              },
              "has_more": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "acquire_result_lease",
      "description": "在结果过期前取得有限读取租约，供受权调用方一致复制并核对内容摘要。",
      "inputSchema": {
        "type": "object",
        "required": [
          "result_ref"
        ],
        "properties": {
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "lease_id",
              "result_ref",
              "expires_at_ms"
            ],
            "properties": {
              "lease_id": {
                "type": "string"
              },
              "result_ref": {
                "type": "string"
              },
              "expires_at_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
