# Keep the image context limited to files copied by Dockerfile.
*
!Dockerfile
!build/
build/*
!build/output/
build/output/*
!build/output/flowsql
!build/output/build-info.json
!build/output/python/
!build/output/python/**
build/output/python/**/__pycache__/
!build/output/lib*.so*
!build/output/static/
!build/output/static/**
!build/output/static/index.html
!build/output/static/vite.svg
!build/output/static/assets/
!build/output/static/assets/*
!build/output/exploration/
!build/output/exploration/**
!.thirdparts_installed/
.thirdparts_installed/*
!.thirdparts_installed/yaml-cpp/
.thirdparts_installed/yaml-cpp/*
!.thirdparts_installed/yaml-cpp/lib/
!.thirdparts_installed/yaml-cpp/lib/libyaml-cpp.so.0.9.0
!config/
config/*
!config/docker/
config/docker/*
!config/docker/flowsql.yml
!config/docker/deploy-visualization.yaml
!src/
src/*
!src/python/
src/python/*
!src/python/requirements.txt
src/python/**/*.egg-info/
src/python/**/__pycache__/
!tools/
tools/*
!tools/product_version.py
!tools/release.py
!src/plugins/
src/plugins/*
!src/plugins/npi/
src/plugins/npi/*
!src/plugins/npi/conf/
!src/plugins/npi/conf/protocols.yml

# Kafka release metadata and safe deployment example; never include real credentials.
!build/output/share/
!build/output/share/kafka/
!build/output/share/kafka/**
!config/kafka/
config/kafka/*
!config/kafka/provider.example.json
!config/kafka/provider.docker.example.json
!config/kafka/deploy-scheduler.example.yaml
