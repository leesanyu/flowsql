if(NOT CMAKE_SCRIPT_MODE_FILE)
    return() # subjects.cmake discovers all thirdparts .cmake files.
endif()
# One fingerprint is built by one process across all worktrees. No partially installed cache is reused.
file(MAKE_DIRECTORY "${PREFIX}" "${INSTALL}")
file(LOCK "${PREFIX}/build.lock" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Kafka cache is locked by another build: ${lock_result}")
endif()
if(EXISTS "${INSTALL}/flowsql-fingerprint" AND EXISTS "${INSTALL}/lib/librdkafka.a")
    file(READ "${INSTALL}/flowsql-fingerprint" cached)
    if(cached STREQUAL FINGERPRINT)
        return()
    endif()
    message(FATAL_ERROR "Kafka installation fingerprint mismatch; choose a new cache directory")
endif()
if(NOT EXISTS "${ARCHIVE}")
    if(OFFLINE)
        message(FATAL_ERROR "Kafka offline build requires a verified source archive or matching installed cache")
    endif()
    file(DOWNLOAD "${URL}" "${ARCHIVE}.download" EXPECTED_HASH "SHA256=${SHA256}" STATUS download_status TLS_VERIFY ON)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
        message(FATAL_ERROR "Kafka source download or checksum verification failed")
    endif()
    file(RENAME "${ARCHIVE}.download" "${ARCHIVE}")
endif()
file(SHA256 "${ARCHIVE}" actual_hash)
if(NOT actual_hash STREQUAL SHA256)
    message(FATAL_ERROR "Kafka source checksum mismatch")
endif()
if(EXISTS "${PREFIX}/source-path")
    file(READ "${PREFIX}/source-path" source_directory)
else()
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(extract_directory "${PREFIX}/source-${nonce}")
    file(MAKE_DIRECTORY "${extract_directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xfz "${ARCHIVE}" WORKING_DIRECTORY "${extract_directory}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Kafka source extraction failed")
    endif()
    set(source_directory "${extract_directory}/librdkafka-${VERSION}")
    execute_process(COMMAND "${PATCH}" -p1 -i "${RECIPE}/gssapi-session-cache.patch" WORKING_DIRECTORY "${source_directory}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Kafka private GSSAPI patch failed")
    endif()
    file(WRITE "${PREFIX}/source-path" "${source_directory}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source_directory}" -B "${PREFIX}/build"
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    "-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
    "-DCMAKE_INSTALL_PREFIX=${INSTALL}" -DCMAKE_INSTALL_LIBDIR=lib
    -DRDKAFKA_BUILD_STATIC=ON -DRDKAFKA_BUILD_EXAMPLES=OFF -DRDKAFKA_BUILD_TESTS=OFF
    -DWITH_SSL=ON -DWITH_SASL=ON -DWITH_CURL=ON -DWITH_ZLIB=ON -DWITH_ZSTD=ON
    -DENABLE_LZ4_EXT=ON -DWITH_PLUGINS=OFF
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Kafka required build components are unavailable")
endif()
# Fail instead of accepting upstream's optional-feature auto-detection fallback.
file(READ "${PREFIX}/build/generated/config.h" configuration)
foreach(feature WITH_SSL WITH_SASL_CYRUS WITH_CURL WITH_ZLIB WITH_ZSTD WITH_SASL_OAUTHBEARER WITH_OAUTHBEARER_OIDC WITH_SASL_SCRAM WITH_LZ4_EXT WITH_SNAPPY)
    if(NOT configuration MATCHES "#define ${feature} 1")
        message(FATAL_ERROR "Kafka required feature is absent: ${feature}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PREFIX}/build" --parallel 4 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Kafka client compilation failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${PREFIX}/build" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Kafka client installation failed")
endif()
file(WRITE "${INSTALL}/flowsql-fingerprint" "${FINGERPRINT}")
