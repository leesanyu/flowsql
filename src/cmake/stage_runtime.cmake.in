file(MAKE_DIRECTORY "@CMAKE_BINARY_DIR@/output/python")
file(COPY "@CMAKE_SOURCE_DIR@/python/flowsql" DESTINATION "@CMAKE_BINARY_DIR@/output/python"
    PATTERN "__pycache__" EXCLUDE PATTERN "*.pyc" EXCLUDE)
foreach(deployment deploy-single.yaml deploy-multi.yaml)
    file(READ "@CMAKE_SOURCE_DIR@/../config/${deployment}" content)
    string(REPLACE "python3 -m flowsql.worker" "./flowsql-worker" content "${content}")
    file(WRITE "@CMAKE_BINARY_DIR@/output/config/${deployment}" "${content}")
endforeach()
