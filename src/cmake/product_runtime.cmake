# Arrow and the Python Worker share an exact PyArrow ABI and one interpreter.
function(flowsql_prepare_product_runtime)
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(requirements "${CMAKE_SOURCE_DIR}/python/requirements.txt")
    set(probe [=[
import importlib, importlib.metadata, pathlib, re, sys
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    line = line.split('#', 1)[0].strip()
    if not line:
        continue
    name, op, expected = re.fullmatch(r'([\w-]+)(==|>=)([\d.]+)', line).groups()
    actual = importlib.metadata.version(name)
    parts = lambda v: tuple(int(x) for x in re.findall(r'\d+', v)[:3])
    assert actual == expected if op == '==' else parts(actual) >= parts(expected), (name, actual, expected)
for name in ('pyarrow', 'fastapi', 'uvicorn', 'polars', 'pandas', 'httpx', 'numpy', 'scipy', 'sklearn', 'statsmodels'):
    importlib.import_module(name)
]=])
    execute_process(COMMAND "${Python3_EXECUTABLE}" -c "${probe}" "${requirements}"
        RESULT_VARIABLE ready OUTPUT_QUIET ERROR_QUIET)
    if(ready EQUAL 0)
        set(worker_python "${Python3_EXECUTABLE}")
    else()
        file(MAKE_DIRECTORY "${THIRDPARTS_PREFIX_DIR}")
        file(LOCK "${THIRDPARTS_PREFIX_DIR}/python-runtime.lock" GUARD FUNCTION TIMEOUT 600)
        set(venv "${THIRDPARTS_INSTALL_DIR}/python-arrow22-${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}")
        if(NOT EXISTS "${venv}/bin/python3")
            execute_process(COMMAND "${Python3_EXECUTABLE}" -c "import ensurepip"
                RESULT_VARIABLE has_venv OUTPUT_QUIET ERROR_QUIET)
            if(NOT has_venv EQUAL 0)
                flowsql_require_system_packages(python3-venv)
            endif()
            execute_process(COMMAND "${Python3_EXECUTABLE}" -m venv "${venv}"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
        set(worker_python "${venv}/bin/python3")
        execute_process(COMMAND "${worker_python}" -c "${probe}" "${requirements}"
            RESULT_VARIABLE ready OUTPUT_QUIET ERROR_QUIET)
        if(NOT ready EQUAL 0)
            message(STATUS "Preparing Python Worker and PyArrow 22.0.0 in ${venv}")
            execute_process(COMMAND "${worker_python}" -m pip install --disable-pip-version-check
                --retries 1 --timeout 30 -r "${requirements}" RESULT_VARIABLE installed TIMEOUT 900)
            if(NOT installed STREQUAL "0")
                message(FATAL_ERROR "Python runtime installation failed (${installed}); check PyPI access and Python wheel support")
            endif()
            execute_process(COMMAND "${worker_python}" -c "${probe}" "${requirements}"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endif()
    execute_process(COMMAND "${worker_python}" -c "import pathlib, pyarrow; print(pathlib.Path(pyarrow.__file__).parent)"
        OUTPUT_VARIABLE pyarrow_dir OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(FLOWSQL_WORKER_PYTHON "${worker_python}" PARENT_SCOPE)
    set(FLOWSQL_PYARROW_DIR "${pyarrow_dir}" PARENT_SCOPE)
    message(STATUS "Python Worker: ${worker_python}; PyArrow: ${pyarrow_dir} (22.0.0)")

    find_program(node NAMES node nodejs)
    find_program(npm NAMES npm)
    set(node_version "0")
    if(node AND npm)
        execute_process(COMMAND "${node}" --version OUTPUT_VARIABLE node_version
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(REGEX REPLACE "^v" "" node_version "${node_version}")
    endif()
    if(NOT (node AND npm AND ((node_version VERSION_GREATER_EQUAL "20.19" AND node_version VERSION_LESS "21")
        OR node_version VERSION_GREATER_EQUAL "22.12")))
        # Ubuntu 24.04's Node 18 cannot build Vite 7. Use a private official binary.
        set(version "22.14.0")
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
            set(arch x64)
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
            set(arch arm64)
        else()
            message(FATAL_ERROR "Install Node 20.19+ (20.x) or 22.12+ and npm for ${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        set(name "node-v${version}-linux-${arch}")
        set(prefix "${THIRDPARTS_INSTALL_DIR}/node")
        set(node "${prefix}/${name}/bin/node")
        set(npm "${prefix}/${name}/bin/npm")
        if(NOT EXISTS "${node}" OR NOT EXISTS "${npm}")
            file(MAKE_DIRECTORY "${prefix}" "${THIRDPARTS_PREFIX_DIR}/node")
            file(LOCK "${THIRDPARTS_PREFIX_DIR}/node/install.lock" GUARD FUNCTION TIMEOUT 600)
            set(base "https://nodejs.org/dist/v${version}")
            file(DOWNLOAD "${base}/SHASUMS256.txt" "${THIRDPARTS_PREFIX_DIR}/node/SHASUMS256.txt"
                TLS_VERIFY ON TIMEOUT 60 STATUS status)
            list(GET status 0 result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Cannot download Node checksums: ${status}")
            endif()
            file(READ "${THIRDPARTS_PREFIX_DIR}/node/SHASUMS256.txt" sums)
            string(REGEX MATCH "([0-9a-f]+)  ${name}\\.tar\\.xz" match "${sums}")
            if(NOT match)
                message(FATAL_ERROR "Official checksum for ${name} not found")
            endif()
            set(sha "${CMAKE_MATCH_1}")
            set(archive "${THIRDPARTS_PREFIX_DIR}/node/${name}.tar.xz")
            file(DOWNLOAD "${base}/${name}.tar.xz" "${archive}" EXPECTED_HASH "SHA256=${sha}"
                TLS_VERIFY ON TIMEOUT 180 STATUS status)
            list(GET status 0 result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Cannot download Node: ${status}")
            endif()
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${prefix}")
        endif()
    endif()
    get_filename_component(node_bin "${node}" DIRECTORY)
    set(FLOWSQL_NODE_BIN "${node_bin}" PARENT_SCOPE)
    set(FLOWSQL_NPM_EXECUTABLE "${npm}" PARENT_SCOPE)
    message(STATUS "Frontend toolchain: ${node}, ${npm}")
endfunction()
