# Wrap each registered test at runtime. No connection values or secret paths are captured by CMake.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(FLOWSQL_TEST_RUNNER "${CMAKE_SOURCE_DIR}/../tools/test_environment/runner.py")
function(add_test)
    cmake_parse_arguments(TEST "" "NAME;WORKING_DIRECTORY" "COMMAND;CONFIGURATIONS" ${ARGV})
    if(NOT TEST_NAME OR NOT TEST_COMMAND)
        message(FATAL_ERROR "Tests must use add_test(NAME ... COMMAND ...) for environment accounting")
    endif()
    _add_test(NAME ${TEST_NAME} COMMAND ${Python3_EXECUTABLE} ${FLOWSQL_TEST_RUNNER}
        case --name ${TEST_NAME} -- ${TEST_COMMAND})
    if(TEST_WORKING_DIRECTORY)
        set_tests_properties(${TEST_NAME} PROPERTIES WORKING_DIRECTORY "${TEST_WORKING_DIRECTORY}")
    endif()
    file(READ "${CMAKE_SOURCE_DIR}/../config/testing/dependencies.json" dependency_json)
    string(JSON dependency ERROR_VARIABLE absent GET "${dependency_json}" tests "${TEST_NAME}")
    if(NOT absent)
        string(JSON services GET "${dependency}" services)
        if(NOT services MATCHES "kafka")
            _add_test(NAME ${TEST_NAME}__environment COMMAND ${Python3_EXECUTABLE} ${FLOWSQL_TEST_RUNNER}
                case --name ${TEST_NAME}__environment -- ${CMAKE_COMMAND} -E true)
            set_tests_properties(${TEST_NAME}__environment PROPERTIES FIXTURES_SETUP "env_${TEST_NAME}"
                WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/output TIMEOUT 65)
            set_property(TEST ${TEST_NAME} PROPERTY FLOWSQL_ENV_FIXTURE "env_${TEST_NAME}")
        endif()
        string(JSON count LENGTH "${dependency}" resources)
        set(resources "")
        if(count GREATER 0)
            math(EXPR last "${count}-1")
            foreach(index RANGE ${last})
                string(JSON resource GET "${dependency}" resources ${index})
                list(APPEND resources "${resource}")
            endforeach()
            set_tests_properties(${TEST_NAME} PROPERTIES RESOURCE_LOCK "${resources}")
        endif()
        set_tests_properties(${TEST_NAME} PROPERTIES LABELS "integration")
    endif()
endfunction()

# Existing suites may add their own fixtures after registration. Append environment fixtures last.
function(flowsql_finalize_environment directory)
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(test IN LISTS tests)
        get_property(fixture TEST ${test} DIRECTORY "${directory}" PROPERTY FLOWSQL_ENV_FIXTURE)
        if(fixture)
            set_property(TEST ${test} DIRECTORY "${directory}" APPEND PROPERTY FIXTURES_REQUIRED "${fixture}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        flowsql_finalize_environment("${child}")
    endforeach()
endfunction()
